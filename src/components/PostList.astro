---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../utils/format';

const base = import.meta.env.BASE_URL;

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<div>
  {
    posts.map((post) => (
      <a href={`${base}blog/${post.id}`} class="post-row group">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <h3 class="post-title font-serif text-[17px] leading-snug" data-en={post.data.titleEn ?? post.data.title}>
            {post.data.title}
          </h3>

          <div class="flex shrink-0 items-center gap-2 text-[11px] tracking-[0.06em] text-ink-3">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <span class="opacity-50">/</span>
            <span>{readingTime(post.body ?? '')} min</span>
          </div>
        </div>

        <p class="mt-2 line-clamp-2 text-[13px] leading-relaxed text-ink-2" data-en={post.data.descriptionEn ?? post.data.description}>{post.data.description}</p>

        {
          post.data.tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[11px] tracking-[0.06em] text-bamboo">
              {post.data.tags.map((tag) => (
                <span>#{tag}</span>
              ))}
            </div>
          )
        }
      </a>
    ))
  }
</div>
