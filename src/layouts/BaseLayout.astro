---
import '../styles/global.css';
import { siteConfig } from '../config/site';
import { profile, nav } from '../data/profile';

interface Props {
  title?: string;
  titleEn?: string;
  description?: string;
  descriptionEn?: string;
  ogType?: 'website' | 'article';
}

const {
  title = `${profile.name.zh} · ${profile.headline.zh}`,
  titleEn = `${profile.name.en} · ${profile.headline.en}`,
  description = siteConfig.description.zh,
  descriptionEn = siteConfig.description.en,
  ogType = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, siteConfig.url);
const base = import.meta.env.BASE_URL; // '/personal_blog/' 或 '/'
const basePrefix = base.replace(/\/$/, '');
let pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
if (basePrefix) pathname = pathname.startsWith(basePrefix) ? pathname.slice(basePrefix.length) || '/' : pathname;
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
const avatar = new URL(`${base}images/avatar.jpg`, siteConfig.url);

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name.zh,
  alternateName: profile.name.en,
  jobTitle: profile.role.zh,
  description: siteConfig.description.zh,
  url: siteConfig.url,
  image: avatar.href,
  email: `mailto:${profile.email}`,
  sameAs: [profile.github, profile.linkedin],
  alumniOf: profile.education.map((e) => e.school.en),
};
---

<!doctype html>
<html lang="zh-CN" data-title-zh={title} data-title-en={titleEn} data-description-zh={description} data-description-en={descriptionEn}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name.zh} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.name.zh} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:image" content={avatar} />
    <meta property="og:image:width" content="988" />
    <meta property="og:image:height" content="988" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={avatar} />

    <meta name="theme-color" content={siteConfig.themeColor.dark} />
    <meta name="color-scheme" content="dark light" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500&family=Playfair+Display:ital,wght@0,400;1,400&family=Inter:wght@300;400&family=Noto+Sans+SC:wght@300;400&family=Noto+Serif+SC:wght@400&family=Fira+Code:wght@400&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // 首屏渲染前确定主题，避免闪一下白底
      (function () {
        try {
          var t = localStorage.getItem('theme');
          document.documentElement.dataset.theme = t === 'light' ? 'light' : 'dark';
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <slot name="head" />
  </head>

  <body>
    <!-- 竹影背景 -->
    <div class="bamboo-art" aria-hidden="true">
      <svg width="100%" height="100%" viewBox="0 0 1200 900" preserveAspectRatio="xMidYMid slice" fill="none">
        <g stroke="currentColor" stroke-width="0.8">
          <line x1="80" y1="900" x2="85" y2="80" />
          <line x1="77" y1="500" x2="93" y2="500" />
          <line x1="75" y1="320" x2="95" y2="320" />
          <path d="M85 100 Q120 60 160 70 Q130 80 100 110" />
          <path d="M80 270 Q40 230 10 240 Q40 250 70 280" />
          <line x1="350" y1="900" x2="345" y2="150" />
          <line x1="343" y1="550" x2="357" y2="550" />
          <line x1="340" y1="380" x2="360" y2="380" />
          <path d="M345 130 Q310 90 280 100 Q310 110 335 140" />
          <path d="M350 300 Q390 260 420 270 Q390 280 360 310" />
          <line x1="900" y1="900" x2="905" y2="100" />
          <line x1="897" y1="480" x2="913" y2="480" />
          <line x1="895" y1="300" x2="915" y2="300" />
          <path d="M905 80 Q940 40 970 50 Q940 60 915 90" />
          <path d="M900 240 Q860 200 830 210 Q860 220 890 250" />
          <line x1="1120" y1="900" x2="1115" y2="50" />
          <line x1="1113" y1="500" x2="1127" y2="500" />
          <line x1="1110" y1="300" x2="1130" y2="300" />
          <path d="M1115 30 Q1150 -10 1180 0 Q1150 10 1125 40" />
          <path d="M1120 200 Q1080 160 1050 170 Q1080 180 1110 210" />
        </g>
      </svg>
    </div>

    <!-- 导航 -->
    <header class="site-header" id="siteHeader">
      <div class="page-container header-inner">
        <a href={base} class="brand" aria-label="Home">{profile.nameShort}</a>

        <nav class="nav-desktop" aria-label="主导航">
          {
            nav.map((item) => (
              <a href={`${base}${item.href.replace(/^\//, '')}`} class="nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>
                <span data-en={item.en}>{item.zh}</span>
              </a>
            ))
          }
        </nav>

        <div class="header-actions">
          <button
            id="langToggle"
            class="lang-btn"
            type="button"
            aria-label="切换语言 / Switch language"
            data-label-zh="EN"
            data-label-en="中文"
          >
            EN
          </button>

          <button
            id="themeToggle"
            class="icon-btn"
            type="button"
            aria-label="切换明暗主题 / Toggle theme"
            title="切换明暗主题"
          >
            <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="12" cy="12" r="4.2" />
              <path stroke-linecap="round" d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4" />
            </svg>
            <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.5 14.3A8.5 8.5 0 1 1 9.7 3.5a7 7 0 0 0 10.8 10.8Z" />
            </svg>
          </button>

          <button
            id="menuToggle"
            class="icon-btn menu-btn"
            type="button"
            aria-label="打开菜单"
            aria-expanded="false"
            aria-controls="mobileMenu"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
        </div>
      </div>

      <div class="mobile-menu" id="mobileMenu" hidden>
        {
          nav.map((item) => (
            <a href={`${base}${item.href.replace(/^\//, '')}`} aria-current={isActive(item.href) ? 'page' : undefined}>
              <span data-en={item.en}>{item.zh}</span>
            </a>
          ))
        }
      </div>
    </header>

    <main class="relative z-10" style="padding-top: 4rem;">
      <slot />
    </main>

    <footer class="relative z-10 border-t" style="border-color: var(--line);">
      <div class="page-container" style="padding-block: 3rem;">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <p class="font-display text-[13px] tracking-[0.3em] text-ink" style="margin-right: -0.3em;">
              {profile.name.zh}
            </p>
            <p class="mt-2 text-[13px] text-ink-3">
              <span data-en={profile.role.en}>{profile.role.zh}</span>
            </p>
            <p class="mt-1 text-[12px] text-ink-3">
              <span data-en={profile.location.en}>{profile.location.zh}</span>
            </p>
          </div>

          <div class="flex flex-wrap gap-x-6 gap-y-2 text-[11px] uppercase tracking-[0.16em] text-ink-3">
            <a class="transition-colors hover:text-accent" href={`mailto:${profile.email}`}>Email</a>
            <a class="transition-colors hover:text-accent" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a class="transition-colors hover:text-accent" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          </div>
        </div>

        <p class="mt-8 text-[11px] tracking-[0.08em] text-ink-3">
          © {new Date().getFullYear()} {profile.name.zh} · Built with Astro
        </p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var header = document.getElementById('siteHeader');
        var langBtn = document.getElementById('langToggle');
        var themeBtn = document.getElementById('themeToggle');
        var menuBtn = document.getElementById('menuToggle');
        var menu = document.getElementById('mobileMenu');
        var langNodes = document.querySelectorAll('[data-en]');

        /* ---------- 主题 ---------- */
        function setTheme(theme, persist) {
          root.dataset.theme = theme;
          if (persist) {
            try { localStorage.setItem('theme', theme); } catch (e) {}
          }
          if (themeBtn) themeBtn.setAttribute('aria-pressed', theme === 'light' ? 'true' : 'false');
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'light' ? '#f8f4ec' : '#0f1310');
        }

        setTheme(root.dataset.theme === 'light' ? 'light' : 'dark', false);

        if (themeBtn) {
          themeBtn.addEventListener('click', function () {
            setTheme(root.dataset.theme === 'light' ? 'dark' : 'light', true);
          });
        }

        /* ---------- 语言 ---------- */
        function setLang(lang, persist) {
          var en = lang === 'en';

          langNodes.forEach(function (el) {
            if (!el.dataset.zh) el.dataset.zh = el.textContent;
            el.textContent = en ? el.dataset.en : el.dataset.zh;
          });

          // 整块内容切换（文章正文等 [data-lang] 容器）
          document.querySelectorAll('[data-lang]').forEach(function (el) {
            el.hidden = el.dataset.lang !== lang;
          });

          root.lang = en ? 'en' : 'zh-CN';
          root.dataset.lang = en ? 'en' : 'zh';

          if (langBtn) {
            langBtn.textContent = en ? langBtn.dataset.labelEn : langBtn.dataset.labelZh;
            langBtn.setAttribute('aria-pressed', en ? 'true' : 'false');
          }

          document.title = en ? root.dataset.titleEn || document.title : root.dataset.titleZh || document.title;

          var desc = en ? root.dataset.descriptionEn : root.dataset.descriptionZh;
          var metaDesc = document.querySelector('meta[name="description"]');
          if (desc && metaDesc) metaDesc.setAttribute('content', desc);

          if (persist) {
            try { localStorage.setItem('lang', lang); } catch (e) {}
          }
        }

        var savedLang = 'zh';
        try { savedLang = localStorage.getItem('lang') === 'en' ? 'en' : 'zh'; } catch (e) {}
        setLang(savedLang, false);

        if (langBtn) {
          langBtn.addEventListener('click', function () {
            setLang(root.dataset.lang === 'en' ? 'zh' : 'en', true);
          });
        }

        /* ---------- 导航栏滚动态 ---------- */
        function onScroll() {
          if (!header) return;
          header.classList.toggle('is-scrolled', window.scrollY > 8);
        }

        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        /* ---------- 移动端菜单 ---------- */
        function closeMenu() {
          if (!menu || !menuBtn) return;
          menu.hidden = true;
          menuBtn.setAttribute('aria-expanded', 'false');
        }

        if (menuBtn && menu) {
          menuBtn.addEventListener('click', function () {
            var open = menu.hidden;
            menu.hidden = !open;
            menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
          });

          menu.addEventListener('click', function (event) {
            if (event.target.closest('a')) closeMenu();
          });

          document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') closeMenu();
          });

          window.addEventListener('resize', function () {
            if (window.innerWidth >= 820) closeMenu();
          });
        }
      })();
    </script>
  </body>
</html>
