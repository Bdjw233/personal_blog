---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/Contact.astro';
---

<BaseLayout
  title="联系 · 沈宇轩"
  titleEn="Contact · Shen Yuxuan"
  description="通过邮箱、微信或 LinkedIn 联系沈宇轩。"
  descriptionEn="Reach Shen Yuxuan by email, WeChat or LinkedIn."
>
  <div class="page-head">
    <div class="page-container">
      <p class="eyebrow">
        <span data-en="Contact">联系</span>
      </p>
      <h1 class="title-lg mt-5">
        <span data-en="Say hello">保持联系</span>
      </h1>
    </div>
  </div>

  <Contact showHead={false} />
</BaseLayout>
